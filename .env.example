# OpenAI — get a key at https://platform.openai.com/api-keys
# IMPORTANT: Never commit real keys. Rotate any key that was shared in chat or email.
OPENAI_API_KEY=sk-your-openai-key-here

# Check Point Infinity Portal / Lakera API credentials
# Create under Global Settings > API Keys (service: GenAI Protect / AI Guardrails)
LAKERA_CLIENT_ID=your-client-id
LAKERA_ACCESS_KEY=your-secret-key
LAKERA_AUTH_URL=https://cloudinfra-gw-us.portal.checkpoint.com/auth/external

# Optional legacy path: static Lakera API key (used only if Client ID/Secret are unset)
# LAKERA_API_KEY=your-lakera-api-key-here

# Optional: Lakera project ID for a custom policy (uses default policy if omitted)
LAKERA_PROJECT_ID=your-lakera-project-id

# Optional: OpenAI model (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: Public site URL for metadata when deployed (e.g. https://lakera-guard-demo.your-subdomain.workers.dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cloudflare local preview (copy to .dev.vars, not committed) ---
# NEXTJS_ENV=development
# OPENAI_API_KEY=...
# LAKERA_API_KEY=...
# LAKERA_PROJECT_ID=...
