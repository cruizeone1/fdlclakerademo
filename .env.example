# OpenAI — get a key at https://platform.openai.com/api-keys
# IMPORTANT: Never commit real keys. Copy real values into .env.local (gitignored).
OPENAI_API_KEY=sk-your-openai-key-here

# Guard SaaS key from https://platform.lakera.ai/account/api-keys
# Copy the one-time secret from the Create dialog (not the table fingerprint).
# Docs: https://docs.lakera.ai/docs/api#authentication
LAKERA_GUARD_API_KEY=your-guard-api-key-here

# Platform management key (projects/policies on platform.lakera.ai) — not used for Guard screening
LAKERA_PLATFORM_API_KEY=your-platform-api-key-here

# Alias some scripts still read
LAKERA_API_KEY=your-lakera-api-key-here

# Project that owns analytics — Crash Dummy Project
LAKERA_PROJECT_ID=project-2733216741

# Virginia processing region (this org 401s on EU)
# Docs: https://docs.lakera.ai/docs/data-regions
LAKERA_GUARD_URL=https://us-east-1.api.lakera.ai/v2/guard

# Infinity Portal credentials — currently the working Guard auth path
LAKERA_CLIENT_ID=your-client-id
LAKERA_ACCESS_KEY=your-secret-key
LAKERA_AUTH_URL=https://cloudinfra-gw-us.portal.checkpoint.com/auth/external

# Optional: OpenAI model (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: Public site URL for metadata when deployed
NEXT_PUBLIC_SITE_URL=http://localhost:3000
